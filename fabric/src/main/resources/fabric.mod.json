{
  "schemaVersion": 1,
  "id": "skyblockpv",
  "version": "${version}",
  "name": "SkyBlock Profile Viewer",
  "description": "View any Hypixel SkyBlock player's stats, gear, storage, dungeons and trophy fishing in game with /pv.",
  "authors": ["StreetInman"],
  "contact": {
    "sources": "https://github.com/StreetInman/skyblock-pv",
    "issues": "https://github.com/StreetInman/skyblock-pv/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.streetinman.skyblockpv.SkyblockPvClient"]
  },
  "mixins": ["skyblockpv.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "${minecraft_range}",
    "java": ">=25"
  }
}
